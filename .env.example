# Auth: the Claude Agent SDK uses your existing Claude Code login if present,
# otherwise it falls back to ANTHROPIC_API_KEY. Leave blank to use your login.
ANTHROPIC_API_KEY=

# Optional override: run em against a repo other than the one you are standing in.
# Normally unnecessary; em discovers the project from your working directory.
EM_TARGET_REPO=

# Port for the web dashboard (em web / npm run web). Defaults to 4788 if unset.
WEB_PORT=
